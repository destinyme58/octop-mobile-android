<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/sheet_gutter"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/sheet_gutter"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/more_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/more_personalization"
            style="@style/Widget.Octop.SheetAction"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="@string/personalization"
            app:icon="@drawable/ic_tune_24"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/more_knowledge"
            style="@style/Widget.Octop.SheetAction"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/knowledge_bases"
            app:icon="@drawable/ic_book_24"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/more_workbench"
            style="@style/Widget.Octop.SheetAction"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/workbench"
            app:icon="@drawable/ic_panels_24"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/more_usage"
            style="@style/Widget.Octop.SheetAction"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/token_usage"
            app:icon="@drawable/ic_chart_24"
            app:iconGravity="textStart" />
    </LinearLayout>

</ScrollView>

