{
  "expo": {
    "name": "Octop Mobile",
    "slug": "octop-mobile-destiny",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "destinyoctop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.destinyme.octopmobile",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.destinyme.octopmobile",
      "versionCode": 3,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-cleartext-traffic",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFAF9",
          "ios": {
            "image": "./assets/images/splash-ios.png",
            "resizeMode": "cover"
          },
          "android": {
            "image": "./assets/images/splash-android-icon.png",
            "imageWidth": 192
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
